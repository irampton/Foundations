{
  "name": "foundations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.js *.json index.html .github/workflows/pages.yml",
    "format:check": "prettier --check src tests *.js *.json index.html .github/workflows/pages.yml"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "prettier": "^3.9.6",
    "vite": "^7.1.0"
  }
}
